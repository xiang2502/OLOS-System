// firestore.rules
// Security rules for OLOS Cloud Firestore.
// Deploy with: firebase deploy --only firestore:rules
//
// These rules enforce:
//   - Authenticated access only
//   - Users can only read/write their own data
//   - Admins (role === 'admin') have full access
//   - Claims can only be created by authenticated users

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── Users collection ────────────────────────────────────────────────────
    // Users can read their own profile; admins can read all profiles.
    // Users can create and update their own profile; admins can update anyone's.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Items collection ────────────────────────────────────────────────────
    // Any authenticated user can read and create items.
    // Only the reporter or an admin can update/delete an item.
    match /items/{itemId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                       (resource.data.reportedBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Claims collection ────────────────────────────────────────────────────
    // Users can create claims and read their own claims.
    // Admins can read and update all claims (to approve/reject).
    match /claims/{claimId} {
      allow create: if isAuthenticated();
      allow read:   if isAuthenticated() &&
                       (resource.data.claimedBy == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
