// storage.rules
// Security rules for Firebase Cloud Storage.
// Deploy with: firebase deploy --only storage

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Item photos ─────────────────────────────────────────────────────────
    // Path: items/{itemId}/{filename}
    // Authenticated users can upload and read; admins can delete.
    match /items/{itemId}/{filename} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024  // max 5 MB
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
